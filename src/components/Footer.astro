---
import { posts } from "../data/posts.js";

const APP = "https://app.aquinace.com";
const WA = "https://wa.me/51918796325?text=Hola%2C%20quiero%20conocer%20aqu%C3%AD%20nace";
const MAIL = "mailto:soporteqipi@aquinace.com";

const latest = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 3);
// Título corto para el footer: hasta el primer "?" o ":", o recortado.
const short = (t: string) => {
	const q = t.indexOf("?");
	if (q > 0 && q < 48) return t.slice(0, q + 1);
	const c = t.indexOf(":");
	if (c > 0 && c < 48) return t.slice(0, c);
	if (t.length <= 44) return t;
	const cut = t.slice(0, 42);
	return cut.slice(0, cut.lastIndexOf(" ")).trim() + "…";
};
const year = new Date().getFullYear();
