---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import WaFab from "../../components/WaFab.astro";
import "../../styles/globals.css";
import { posts } from "../../data/posts.js";

export function getStaticPaths() {
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const SITE = "https://aquinace.com";
const url = `${SITE}/blog/${post.slug}`;
const WA =
	"https://wa.me/51918796325?text=%F0%9F%92%9A%20Hola%2C%20quiero%20conocer%20aqu%C3%AD%20nace%20%F0%9F%9A%80";

const related = posts.filter((p) => p.slug !== post.slug).slice(0, 3);

const articleSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: post.description,
	datePublished: post.date,
	dateModified: post.date,
	author: { "@type": "Organization", name: "aquí nace", url: SITE },
	publisher: {
		"@type": "Organization",
		name: "aquí nace",
		logo: { "@type": "ImageObject", url: SITE + "/icon-512.png" },
	},
	mainEntityOfPage: { "@type": "WebPage", "@id": url },
	inLanguage: "es-PE",
	keywords: post.keywords,
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Inicio", item: SITE },
		{ "@type": "ListItem", position: 2, name: "Blog", item: SITE + "/blog" },
		{ "@type": "ListItem", position: 3, name: post.title, item: url },
	],
};

const dateLabel = new Date(post.date + "T00:00:00").toLocaleDateString("es-PE", {
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<Layout
	title={`${post.title} | aquí nace`}
	description={post.description}
	keywords={post.keywords}
	type="article"
	publishedTime={post.date}
	canonicalPath={`/blog/${post.slug}`}
	jsonLd={[articleSchema, breadcrumbSchema]}
>
	<Nav current="blog" />

	<main class="page-top">
		<article class="container post-container">
			<nav class="breadcrumb" aria-label="Ruta de navegación">
				<a href="/">Inicio</a>
				<span>/</span>
				<a href="/blog">Blog</a>
				<span>/</span>
				<span class="crumb-current">{post.category}</span>
			</nav>

			<header class="post-header">
				<span class="eyebrow">{post.category}</span>
				<h1 class="h-section">{post.title}</h1>
				<p class="lead">{post.description}</p>
				<div class="post-meta">
					<span class="author">Equipo aquí nace</span>
					<span class="dot">·</span>
					<time datetime={post.date}>{dateLabel}</time>
					<span class="dot">·</span>
					<span>{post.readingTime} de lectura</span>
				</div>
			</header>

			<div class="post-body" set:html={post.body} />

			<aside class="post-cta band-dark">
				<div>
					<span class="eyebrow">Da el siguiente paso</span>
					<h3>Lleva tu organización al siguiente nivel</h3>
					<p>
						aquí nace digitaliza aportes, préstamos, ahorros e inversiones de
						tu UNICA, banca comunal o asociación. Todo claro, en una sola app.
					</p>
				</div>
				<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
					Empezar con aquí nace
					<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
				</a>
			</aside>
		</article>

		<section class="container related">
			<h2 class="h-card">Sigue leyendo</h2>
			<div class="related-grid">
				{related.map((p) => (
					<a href={`/blog/${p.slug}`} class="related-card card-tint">
						<span class="related-cat">{p.category}</span>
						<h3>{p.title}</h3>
						<span class="related-read">
							Leer
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</span>
					</a>
				))}
			</div>
		</section>
	</main>

	<WaFab href={WA} />
	<Footer />
</Layout>

<style>
	main {
		padding-bottom: 104px;
	}
	.post-container {
		max-width: 780px;
	}
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-size: 0.82rem;
		color: var(--muted-2);
		margin-bottom: 32px;
	}
	.breadcrumb a {
		color: var(--brand);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		text-decoration: underline;
	}
	.crumb-current {
		color: var(--muted);
	}
	.post-header {
		margin-bottom: 44px;
		padding-bottom: 36px;
		border-bottom: 1px solid var(--line);
	}
	.post-header h1 {
		margin-bottom: 18px;
	}
	.post-header .lead {
		margin-bottom: 22px;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		font-size: 0.875rem;
		color: var(--muted-2);
	}
	.post-meta .author {
		color: var(--ink);
		font-weight: 500;
	}
	.post-meta .dot {
		color: var(--line-strong);
	}

	/* Article body */
	.post-body :global(h2) {
		font-size: 1.65rem;
		font-weight: 500;
		letter-spacing: -0.025em;
		color: var(--ink);
		margin: 44px 0 14px;
		line-height: 1.25;
	}
	.post-body :global(h3) {
		font-size: 1.2rem;
		font-weight: 500;
		color: var(--brand-deep);
		margin: 30px 0 10px;
	}
	.post-body :global(p) {
		color: var(--ink-2);
		font-size: 1.06rem;
		line-height: 1.8;
		margin-bottom: 18px;
	}
	.post-body :global(ul),
	.post-body :global(ol) {
		margin: 0 0 22px;
		padding-left: 24px;
	}
	.post-body :global(li) {
		color: var(--ink-2);
		font-size: 1.06rem;
		line-height: 1.75;
		margin-bottom: 10px;
	}
	.post-body :global(li::marker) {
		color: var(--brand);
	}
	.post-body :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}
	.post-body :global(a) {
		color: var(--brand);
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.post-body :global(a:hover) {
		color: var(--brand-deep);
	}
	.post-body :global(blockquote) {
		margin: 24px 0;
		padding: 20px 24px;
		border-left: 3px solid var(--brand);
		background: var(--tint-2);
		border-radius: 0 14px 14px 0;
	}

	/* CTA */
	.post-cta {
		margin-top: 56px;
		padding: clamp(32px, 5vw, 48px);
		border-radius: var(--radius-lg);
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		align-items: center;
	}
	@media (min-width: 760px) {
		.post-cta {
			grid-template-columns: 1fr auto;
		}
	}
	.post-cta h3 {
		font-size: 1.5rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin-bottom: 10px;
	}
	.post-cta p {
		line-height: 1.7;
		max-width: 520px;
	}

	/* Related */
	.related {
		margin-top: 80px;
	}
	.related h2 {
		margin-bottom: 24px;
	}
	.related-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
	}
	@media (min-width: 760px) {
		.related-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.related-card {
		display: flex;
		flex-direction: column;
		padding: 26px;
		text-decoration: none;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}
	.related-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}
	.related-cat {
		font-size: 0.72rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--brand);
	}
	.related-card h3 {
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.35;
		margin: 10px 0 18px;
		flex: 1;
	}
	.related-read {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.875rem;
	}
</style>
