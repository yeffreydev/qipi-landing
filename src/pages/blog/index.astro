---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import WaFab from "../../components/WaFab.astro";
import "../../styles/globals.css";
import { posts } from "../../data/posts.js";

const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const [featured, ...rest] = sorted;

const fmt = (d: string) =>
	new Date(d + "T00:00:00").toLocaleDateString("es-PE", { year: "numeric", month: "short", day: "numeric" });

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: "Blog de aquí nace — Finanzas comunitarias en Perú",
	description:
		"Artículos sobre UNICAs, bancas comunales, ahorro grupal y herramientas de finanzas en Perú.",
	url: "https://aquinace.com/blog",
	blogPost: sorted.map((p) => ({
		"@type": "BlogPosting",
		headline: p.title,
		description: p.description,
		datePublished: p.date,
		url: "https://aquinace.com/blog/" + p.slug,
	})),
};
---

<Layout
	title="Blog de aquí nace — Finanzas comunitarias, UNICAs y banca comunal en Perú"
	description="Aprende sobre UNICAs, bancas comunales, ahorro grupal y las mejores herramientas de finanzas en Perú. Guías prácticas para tu asociación o comunidad."
	keywords="blog finanzas comunitarias, qué es una UNICA, qué es una banca comunal, herramientas de finanzas Perú, ahorro grupal, educación financiera Perú"
	canonicalPath="/blog"
	jsonLd={jsonLd}
>
	<Nav current="blog" />

	<main class="page-top">
		<div class="container">
			<header class="blog-hero">
				<span class="eyebrow">Blog</span>
				<h1 class="h-display">Finanzas comunitarias para el Perú.</h1>
				<p class="lead">
					Todo sobre UNICAs, bancas comunales, ahorro grupal y las mejores
					herramientas de finanzas para tu organización.
				</p>
			</header>

			{featured && (
				<a href={`/blog/${featured.slug}`} class="featured card-raised reveal">
					<div class="featured-copy">
						<div class="meta">
							<span class="cat">{featured.category}</span>
							<span class="dot">·</span>
							<time datetime={featured.date}>{fmt(featured.date)}</time>
							<span class="dot">·</span>
							<span>{featured.readingTime}</span>
						</div>
						<h2 class="h-section">{featured.title}</h2>
						<p>{featured.description}</p>
						<span class="btn-link">
							Leer artículo
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</span>
					</div>
					<div class="featured-art" aria-hidden="true">
						<div class="stripes on-brand"></div>
						<img src="/aquinace-light.svg" alt="" width="180" height="52" />
					</div>
				</a>
			)}

			<div class="blog-grid">
				{rest.map((p) => (
					<a href={`/blog/${p.slug}`} class="post card-tint reveal">
						<div class="meta">
							<span class="cat">{p.category}</span>
							<span class="dot">·</span>
							<span>{p.readingTime}</span>
						</div>
						<h2>{p.title}</h2>
						<p>{p.description}</p>
						<span class="post-foot">
							<time datetime={p.date}>{fmt(p.date)}</time>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</main>

	<WaFab />
	<Footer />
</Layout>

<style>
	main {
		padding-bottom: 104px;
	}
	.blog-hero {
		max-width: 680px;
		margin-bottom: 56px;
	}
	.blog-hero h1 {
		margin-bottom: 20px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		font-size: 0.8rem;
		color: var(--muted-2);
		margin-bottom: 16px;
	}
	.cat {
		color: var(--brand);
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: 0.72rem;
	}
	.dot {
		color: var(--line-strong);
	}

	.featured {
		display: grid;
		grid-template-columns: 1fr;
		text-decoration: none;
		overflow: hidden;
		margin-bottom: 28px;
		transition: transform 0.3s ease;
	}
	.featured:hover {
		transform: translateY(-3px);
	}
	@media (min-width: 900px) {
		.featured {
			grid-template-columns: 1.3fr 0.9fr;
		}
	}
	.featured-copy {
		padding: clamp(32px, 5vw, 56px);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.featured-copy h2 {
		margin-bottom: 16px;
	}
	.featured-copy p {
		color: var(--muted);
		line-height: 1.7;
		margin-bottom: 26px;
		max-width: 560px;
	}
	.featured-art {
		position: relative;
		min-height: 220px;
		background: var(--brand);
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.featured-art .stripes {
		left: 25%;
	}
	.featured-art img {
		position: relative;
		width: 180px;
		height: auto;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 22px;
	}
	@media (min-width: 680px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1000px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.post {
		display: flex;
		flex-direction: column;
		padding: 32px;
		text-decoration: none;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}
	.post:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}
	.post h2 {
		font-size: 1.3rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}
	.post p {
		color: var(--muted);
		font-size: 0.93rem;
		line-height: 1.65;
		flex: 1;
	}
	.post-foot {
		margin-top: 26px;
		padding-top: 18px;
		border-top: 1px solid var(--line-strong);
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.82rem;
		color: var(--muted-2);
	}
	.post-foot svg {
		color: var(--ink);
	}
</style>
