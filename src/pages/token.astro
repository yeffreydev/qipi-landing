---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WaFab from "../components/WaFab.astro";
import "../styles/globals.css";

const SITE = "https://aquinace.com";
const WA =
	"https://wa.me/51918796325?text=Hola%2C%20quiero%20conocer%20el%20token%20de%20aqu%C3%AD%20nace%20%F0%9F%AA%99";

const tokenJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	name: "AN Token — El token de aquí nace",
	description:
		"AN es el token de aquí nace, creado para impulsar el proyecto y el ecosistema de aquí nace.",
	url: SITE + "/token",
	inLanguage: "es-PE",
};
---

<Layout
	title="AN Token — El token de aquí nace"
	description="AN es el token de aquí nace, creado para impulsar el proyecto y el ecosistema de aquí nace."
	keywords="token aquí nace, AN token, ecosistema aquí nace, criptomoneda aquí nace, finanzas comunitarias token"
	canonicalPath="/token"
	jsonLd={tokenJsonLd}
>
	<Nav current="token" />

	<main>
		<!-- ================= HERO ================= -->
		<section class="hero">
			<div class="stripes" aria-hidden="true"></div>
			<div class="container hero-grid">
				<div class="hero-copy">
					<span class="eyebrow">Token AN</span>
					<h1 class="h-display">
						AN, el token de
						<span class="wordmark"><span class="wm-a">aquí</span><span class="wm-n">nace</span></span>
					</h1>
					<p class="lead hero-lead">
						Aquí nace <strong>AN</strong>: el token creado para
						<strong>impulsar el proyecto</strong> y hacer crecer todo el
						<strong>ecosistema de aquí nace</strong>. Una pieza más de nuestra
						misión: acercar más oportunidades financieras a las comunidades.
					</p>
					<div class="hero-cta">
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Quiero enterarme primero</a>
						<a href="/#servicios" class="btn btn-outline btn-lg">
							Conoce la plataforma
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
					</div>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<div class="token-tile card-tint">
						<img
							class="token-logo"
							src="/an-token.png"
							alt="AN — token de aquí nace"
							width="1254"
							height="1254"
						/>
					</div>
					<div class="token-chip">
						<span>Estado</span>
						<strong>En desarrollo</strong>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= PROPÓSITO ================= -->
		<section class="section-tight">
			<div class="container">
				<div class="card-raised purpose reveal">
					<div class="purpose-head">
						<div>
							<span class="eyebrow">Propósito</span>
							<h2 class="h-section">¿Para qué nace AN?</h2>
						</div>
						<p>Un token pensado para fortalecer a la comunidad y potenciar el crecimiento de todo el ecosistema.</p>
					</div>
					<div class="purpose-grid">
						<article class="purpose-item">
							<svg class="icon-line" viewBox="0 0 40 40"><path d="M22 4 8 22h11l-1 14 14-18H21l1-14z" /></svg>
							<h3>Impulsa el proyecto</h3>
							<p>AN aporta el combustible para acelerar el desarrollo de aquí nace y llegar a más comunidades.</p>
						</article>
						<article class="purpose-item">
							<svg class="icon-line" viewBox="0 0 40 40"><circle cx="20" cy="12" r="5" /><circle cx="9" cy="28" r="5" /><circle cx="31" cy="28" r="5" /><path d="M16 15.5 12 23M24 15.5l4 7.5M14 28h12" /></svg>
							<h3>Fortalece el ecosistema</h3>
							<p>Conecta a personas, asociaciones y aliados dentro de una misma red que crece junta.</p>
						</article>
						<article class="purpose-item">
							<svg class="icon-line" viewBox="0 0 40 40"><path d="M6 30 16 20l6 6 12-14" /><path d="M26 12h8v8" /></svg>
							<h3>Crecimiento compartido</h3>
							<p>El valor que se genera en la plataforma regresa a quienes hacen posible la comunidad.</p>
						</article>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= LLEGA PRONTO ================= -->
		<section class="section-tight">
			<div class="container">
				<div class="cta band-dark reveal">
					<div class="stripes on-brand" aria-hidden="true"></div>
					<div class="cta-copy">
						<span class="eyebrow">Próximamente</span>
						<h2 class="h-section">El token AN llega pronto.</h2>
						<p>
							Estamos afinando cada detalle para lanzarlo de forma
							<strong>clara, segura y transparente.</strong> Déjanos tu contacto y
							serás de los primeros en conocerlo.
						</p>
					</div>
					<div class="cta-actions">
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Avísame cuando esté listo</a>
					</div>
				</div>
				<p class="disclaimer reveal">
					AN se encuentra en desarrollo. Esta página es solo informativa y no
					constituye una oferta de inversión.
				</p>
			</div>
		</section>
	</main>

	<WaFab href={WA} />
	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		padding: calc(var(--nav-h) + 64px) 0 96px;
		overflow: hidden;
	}
	.hero .stripes {
		left: 50%;
	}
	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 56px;
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid {
			grid-template-columns: 1.15fr 0.85fr;
			gap: 40px;
		}
	}
	.hero-copy h1 {
		margin-bottom: 24px;
	}
	.hero-copy h1 .wordmark {
		font-size: 0.95em;
	}
	.hero-lead {
		max-width: 540px;
		margin-bottom: 32px;
	}
	.hero-lead strong {
		color: var(--ink);
		font-weight: 600;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-visual {
		position: relative;
		max-width: 420px;
		margin: 0 auto;
		width: 100%;
	}
	.token-tile {
		padding: 36px;
		border-radius: var(--radius-xl);
	}
	.token-logo {
		width: 100%;
		height: auto;
		border-radius: 50%;
		filter: drop-shadow(0 30px 60px rgba(6, 101, 90, 0.25));
		animation: float 7s ease-in-out infinite;
	}
	.token-chip {
		position: absolute;
		left: -12px;
		bottom: 28px;
		background: var(--surface);
		border-radius: 14px;
		padding: 14px 18px;
		box-shadow: var(--shadow-float);
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.token-chip span {
		font-size: 0.75rem;
		color: var(--muted);
	}
	.token-chip strong {
		color: var(--ink);
		font-weight: 500;
	}
	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.token-logo {
			animation: none;
		}
	}

	.purpose {
		padding: clamp(36px, 6vw, 72px);
	}
	.purpose-head {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		align-items: end;
		margin-bottom: 56px;
	}
	.purpose-head p {
		color: var(--muted);
		line-height: 1.7;
		max-width: 400px;
	}
	@media (min-width: 900px) {
		.purpose-head {
			grid-template-columns: 1.2fr 1fr;
		}
		.purpose-head p {
			justify-self: end;
		}
	}
	.purpose-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
	}
	@media (min-width: 760px) {
		.purpose-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.purpose-item h3 {
		font-size: 1.25rem;
		font-weight: 500;
		margin: 26px 0 10px;
	}
	.purpose-item p {
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.cta {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-xl);
		padding: clamp(40px, 6vw, 72px);
		display: grid;
		grid-template-columns: 1fr;
		gap: 36px;
		align-items: center;
	}
	.cta .stripes {
		left: 40%;
	}
	.cta-copy,
	.cta-actions {
		position: relative;
	}
	@media (min-width: 900px) {
		.cta {
			grid-template-columns: 1.3fr 1fr;
		}
		.cta-actions {
			justify-content: flex-end;
		}
	}
	.cta-copy p {
		margin-top: 16px;
		max-width: 460px;
		line-height: 1.7;
	}
	.cta-copy strong {
		color: #fff;
		font-weight: 500;
	}
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.disclaimer {
		margin-top: 20px;
		text-align: center;
		font-size: 0.85rem;
		color: var(--muted-2);
	}
</style>
