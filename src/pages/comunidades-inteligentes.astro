---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WaFab from "../components/WaFab.astro";
import "../styles/globals.css";

const SITE = "https://aquinace.com";
const WA =
	"https://wa.me/51918796325?text=Hola%2C%20quiero%20crear%20una%20comunidad%20inteligente%20con%20aqu%C3%AD%20nace%20%F0%9F%8C%B1";

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: "Comunidades Inteligentes — aquí nace",
		description:
			"Con aquí nace creas comunidades inteligentes sin necesidad de tener mucho conocimiento: una economía propia que se diferencia y prospera, herramientas de gestión, academia y más.",
		url: SITE + "/comunidades-inteligentes",
		inLanguage: "es-PE",
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: [
			{
				"@type": "Question",
				name: "¿Qué es una comunidad inteligente de aquí nace?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "Es una comunidad —una UNICA, banca comunal, junta o asociación— que gestiona su dinero, sus reglas y su crecimiento con la tecnología de aquí nace. Tiene su propia economía, herramientas digitales, academia de aprendizaje y una red de apoyo, todo en un solo lugar.",
				},
			},
			{
				"@type": "Question",
				name: "¿Necesito conocimientos técnicos o financieros para crearla?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "No. aquí nace está diseñada para que cualquier persona pueda crear y liderar su comunidad sin conocimientos previos. La plataforma guía cada paso, automatiza los cálculos y te acompaña con su academia y su red.",
				},
			},
			{
				"@type": "Question",
				name: "¿Qué hace que la economía de una comunidad inteligente prospere?",
				acceptedAnswer: {
					"@type": "Answer",
					text: "El dinero se queda y circula dentro de la comunidad: los aportes, préstamos e intereses regresan a los propios miembros. Con reglas claras, transparencia total y herramientas que evitan errores, la economía de la comunidad se diferencia de la banca tradicional y crece de forma sostenible.",
				},
			},
		],
	},
];

const members = [
	{ n: "María Q.", r: "Presidenta", a: "M" },
	{ n: "José L.", r: "Tesorero", a: "J" },
	{ n: "Rosa H.", r: "Socia", a: "R" },
	{ n: "Luis A.", r: "Socio", a: "L" },
];
---

<Layout
	title="Comunidades Inteligentes — Crea la tuya sin conocimientos previos | aquí nace"
	description="Con aquí nace creas comunidades inteligentes sin necesidad de tener mucho conocimiento: una economía propia que se diferencia y prospera, herramientas, academia y una red que te acompaña."
	keywords="comunidades inteligentes, comunidad inteligente Perú, economía comunitaria, crear comunidad, finanzas comunitarias, academia financiera, herramientas de finanzas, aquí nace"
	canonicalPath="/comunidades-inteligentes"
	jsonLd={jsonLd}
>
	<Nav current="comunidades" />

	<main>
		<!-- ================= HERO ================= -->
		<section class="hero">
			<div class="stripes" aria-hidden="true"></div>
			<div class="container hero-grid">
				<div class="hero-copy">
					<span class="eyebrow">Comunidades inteligentes</span>
					<h1 class="h-display">
						Crea comunidades inteligentes sin ser un experto.
					</h1>
					<p class="lead hero-lead">
						Con <span class="wordmark"><span class="wm-a">aquí</span><span class="wm-n">nace</span></span>
						cualquiera puede formar una comunidad que ahorra, presta y crece con orden.
						Sin conocimientos previos. Con una economía propia que se diferencia y prospera,
						herramientas, academia y una red que te acompaña.
					</p>
					<div class="hero-cta">
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Crea tu comunidad</a>
						<a href="#pilares" class="btn btn-outline btn-lg">
							Cómo funciona
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
					</div>
					<p class="hero-note">Sin experiencia técnica · Te guiamos paso a paso</p>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<div class="mock-members">
						<div class="mock-title">
							<strong>Comunidad Los Andes</strong>
							<span>18 socios</span>
						</div>
						{members.map((m) => (
							<div class="mock-member">
								<span class="mock-av">{m.a}</span>
								<span class="mock-name">{m.n}</span>
								<span class="mock-role">{m.r}</span>
								<span class="mock-ok">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
								</span>
							</div>
						))}
						<div class="mock-add">+ Invitar socio</div>
					</div>

					<div class="mock-econ">
						<span class="mock-econ-label">Economía de la comunidad</span>
						<strong>S/ 18,650</strong>
						<div class="mock-econ-row">
							<span>Aportes</span><b>S/ 12,400</b>
						</div>
						<div class="mock-econ-row">
							<span>Préstamos activos</span><b>S/ 5,100</b>
						</div>
						<div class="mock-econ-row">
							<span>Intereses del ciclo</span><b>S/ 1,150</b>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= QUÉ ES ================= -->
		<section class="section-tight">
			<div class="container">
				<div class="card-raised intro reveal">
					<div>
						<span class="eyebrow">Qué es</span>
						<h2 class="h-section">¿Qué es una comunidad inteligente?</h2>
					</div>
					<div class="intro-copy">
						<p>
							Es un grupo de personas —una UNICA, banca comunal, junta o asociación— que gestiona
							su dinero, sus reglas y su crecimiento con tecnología. Ahorra en conjunto, se presta
							entre sí y aprende, todo desde un mismo lugar.
						</p>
						<blockquote>
							“No necesitas ser contador ni experto en finanzas. Solo necesitas tu comunidad.
							<strong>De lo demás nos encargamos juntos.</strong>”
						</blockquote>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= PILARES (bento) ================= -->
		<section class="section" id="pilares">
			<div class="container">
				<div class="section-head reveal">
					<span class="eyebrow">Pilares</span>
					<h2 class="h-section">Todo lo que hace inteligente a tu comunidad</h2>
					<p>Cuatro pilares que convierten a un grupo cualquiera en una comunidad que prospera.</p>
				</div>

				<div class="pillars">
					<article class="card-tint pillar reveal">
						<svg class="icon-line" viewBox="0 0 40 40"><path d="M20 6a6 6 0 1 1 0 12 6 6 0 0 1 0-12zM8 34a12 12 0 0 1 24 0" /><path d="m26 14 3 3 6-6" /></svg>
						<h3>Sin conocimientos previos</h3>
						<p>
							La plataforma te guía en cada paso: crear la comunidad, sumar miembros, definir
							reglas y registrar aportes. Sin tecnicismos, sin papeleo, sin miedo a equivocarte.
						</p>
					</article>
					<article class="card-tint pillar reveal">
						<svg class="icon-line" viewBox="0 0 40 40"><circle cx="20" cy="20" r="14" /><path d="M20 12v16M24 15.5c-1-1.5-2.5-2-4-2-2.5 0-4 1.3-4 3 0 4 8 2 8 6 0 1.7-1.5 3-4 3-1.5 0-3-.5-4-2" /></svg>
						<h3>Una economía que se diferencia y prospera</h3>
						<p>
							El dinero se queda y circula dentro de tu comunidad. Los aportes, préstamos e
							intereses regresan a los miembros, no a un banco externo. Una economía propia,
							transparente y hecha para crecer de forma sostenible.
						</p>
					</article>
					<article class="card-tint pillar reveal">
						<svg class="icon-line" viewBox="0 0 40 40"><rect x="6" y="8" width="28" height="24" rx="4" /><path d="M6 15h28M12 22h6M12 26h10M24 22h4" /></svg>
						<h3>Herramientas que hacen el trabajo pesado</h3>
						<p>
							Aportes, préstamos, cuotas e intereses calculados de forma automática. Cada
							movimiento queda registrado y todos ven la misma información desde su celular.
							Adiós al cuaderno y a las cuentas que no cuadran.
						</p>
					</article>
					<article class="card-tint pillar reveal">
						<svg class="icon-line" viewBox="0 0 40 40"><path d="M6 10c4-2 8-2 14 1 6-3 10-3 14-1v20c-4-2-8-2-14 1-6-3-10-3-14-1V10zM20 11v20" /></svg>
						<h3>Academia para crecer aprendiendo</h3>
						<p>
							Cursos y guías simples de ahorro, crédito e inversión, pensados para tu realidad.
							Tu comunidad no solo maneja mejor su dinero: aprende a hacerlo crecer.
						</p>
					</article>
				</div>

				<p class="more reveal">
					Y más: red de apoyo entre comunidades, foro integrado, marketplace comunitario y el
					<a href="/token">token AN</a> para potenciar todo el ecosistema.
				</p>
			</div>
		</section>

		<!-- ================= PASOS (banda oscura) ================= -->
		<section class="band-dark steps">
			<div class="container">
				<div class="steps-head reveal">
					<span class="eyebrow">Cómo funciona</span>
					<h2 class="h-section">Crea la tuya en 3 pasos.</h2>
					<p>Sin vueltas. Empiezas hoy y tu comunidad queda lista para crecer.</p>
				</div>
				<div class="steps-grid">
					<article class="step reveal">
						<span class="step-n">1</span>
						<h3>Crea tu comunidad</h3>
						<p>Ponle nombre, invita a los miembros y define las reglas con la ayuda de la plataforma.</p>
					</article>
					<article class="step reveal">
						<span class="step-n">2</span>
						<h3>Activa su economía</h3>
						<p>Registra aportes y préstamos. aquí nace calcula todo y mantiene las cuentas claras.</p>
					</article>
					<article class="step reveal">
						<span class="step-n">3</span>
						<h3>Aprende y prospera</h3>
						<p>Usa la academia y las herramientas para hacer crecer el capital de tu comunidad.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- ================= CTA ================= -->
		<section class="section-tight">
			<div class="container">
				<div class="cta band-dark reveal">
					<div class="cta-copy">
						<span class="eyebrow">Empieza hoy</span>
						<h2 class="h-section">Tu comunidad tiene todo para prosperar.</h2>
						<p>
							Solo falta dar el primer paso. Crea una comunidad inteligente y deja que la tecnología,
							la academia y la red trabajen a tu favor.
						</p>
						<p class="cta-sub">
							¿Quieres entender el modelo a fondo? Lee
							<a href="/blog/como-son-comunidades-inteligentes-aqui-nace">cómo funcionan las comunidades inteligentes</a>.
						</p>
					</div>
					<div class="cta-actions">
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Crea tu comunidad</a>
						<a href="/blog" class="btn btn-ghost-dark btn-lg">
							Ir al blog
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<WaFab href={WA} />
	<Footer />
</Layout>

<style>
	.hero {
		position: relative;
		padding: calc(var(--nav-h) + 64px) 0 96px;
		overflow: hidden;
	}
	.hero .stripes {
		left: 50%;
	}
	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 64px;
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 40px;
		}
	}
	.hero-copy h1 {
		margin-bottom: 24px;
		max-width: 620px;
	}
	.hero-lead {
		max-width: 540px;
		margin-bottom: 32px;
	}
	.hero-lead .wordmark {
		font-size: 1.05em;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-note {
		margin-top: 16px;
		font-size: 0.85rem;
		color: var(--muted-2);
	}

	/* Mockups */
	.hero-visual {
		position: relative;
		min-height: 420px;
		max-width: 480px;
		margin: 0 auto;
		width: 100%;
	}
	.mock-members {
		position: relative;
		width: min(340px, 80%);
		background: var(--surface);
		border-radius: 22px;
		padding: 22px;
		box-shadow: var(--shadow-float);
	}
	.mock-title {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 14px;
	}
	.mock-title strong {
		color: var(--ink);
		font-weight: 500;
	}
	.mock-title span {
		font-size: 0.78rem;
		color: var(--muted-2);
	}
	.mock-member {
		display: grid;
		grid-template-columns: 34px 1fr auto 20px;
		align-items: center;
		gap: 10px;
		padding: 10px 0;
		border-top: 1px solid var(--line);
		font-size: 0.86rem;
	}
	.mock-av {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--tint);
		color: var(--brand-deep);
		font-weight: 600;
		display: grid;
		place-items: center;
	}
	.mock-name {
		color: var(--ink);
		font-weight: 500;
	}
	.mock-role {
		color: var(--muted-2);
		font-size: 0.78rem;
	}
	.mock-ok {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--brand);
		color: #fff;
		display: grid;
		place-items: center;
	}
	.mock-ok svg {
		width: 12px;
		height: 12px;
	}
	.mock-add {
		margin-top: 12px;
		padding: 12px;
		border: 1px dashed var(--line-strong);
		border-radius: 12px;
		text-align: center;
		font-size: 0.86rem;
		color: var(--brand);
		font-weight: 500;
	}
	.mock-econ {
		position: absolute;
		right: 0;
		bottom: -24px;
		width: min(250px, 60%);
		background: var(--brand-deep);
		color: #fff;
		border-radius: 18px;
		padding: 20px;
		box-shadow: var(--shadow-float);
		display: flex;
		flex-direction: column;
	}
	.mock-econ-label {
		font-size: 0.75rem;
		opacity: 0.8;
	}
	.mock-econ > strong {
		font-size: 1.7rem;
		font-weight: 500;
		letter-spacing: -0.03em;
		margin: 2px 0 12px;
	}
	.mock-econ-row {
		display: flex;
		justify-content: space-between;
		font-size: 0.8rem;
		padding: 7px 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}
	.mock-econ-row span {
		opacity: 0.8;
	}
	.mock-econ-row b {
		font-weight: 500;
	}

	/* Intro card */
	.intro {
		padding: clamp(36px, 6vw, 72px);
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
	}
	@media (min-width: 900px) {
		.intro {
			grid-template-columns: 1fr 1fr;
			gap: 64px;
		}
	}
	.intro-copy p {
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.75;
	}
	.intro-copy blockquote {
		margin-top: 24px;
		padding: 22px 26px;
		border-left: 3px solid var(--brand);
		background: var(--tint-2);
		border-radius: 0 14px 14px 0;
		color: var(--ink);
		font-size: 1.05rem;
		line-height: 1.6;
	}
	.intro-copy blockquote strong {
		color: var(--brand-deep);
		font-weight: 600;
	}

	/* Pillars */
	.pillars {
		display: grid;
		grid-template-columns: 1fr;
		gap: 22px;
	}
	@media (min-width: 800px) {
		.pillars {
			grid-template-columns: 1fr 1fr;
		}
	}
	.pillar {
		padding: 40px;
	}
	.pillar h3 {
		font-size: 1.4rem;
		font-weight: 500;
		margin: 26px 0 12px;
		letter-spacing: -0.02em;
	}
	.pillar p {
		color: var(--muted);
		line-height: 1.7;
		font-size: 0.96rem;
	}
	.more {
		text-align: center;
		margin-top: 40px;
		color: var(--muted);
		max-width: 620px;
		margin-inline: auto;
	}
	.more a {
		color: var(--brand);
		font-weight: 500;
	}

	/* Steps */
	.steps {
		padding: 104px 0;
	}
	.steps-head {
		max-width: 640px;
		margin-bottom: 56px;
	}
	.steps-head p {
		margin-top: 14px;
	}
	.steps-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 22px;
	}
	@media (min-width: 760px) {
		.steps-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.step {
		padding: 36px 32px 32px;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.step-n {
		display: block;
		font-size: 4rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.05em;
		margin-bottom: 26px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.05));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	.step h3 {
		font-size: 1.25rem;
		font-weight: 500;
		margin-bottom: 10px;
	}
	.step p {
		font-size: 0.93rem;
		line-height: 1.7;
	}

	/* CTA */
	.cta {
		border-radius: var(--radius-xl);
		padding: clamp(40px, 6vw, 72px);
		display: grid;
		grid-template-columns: 1fr;
		gap: 36px;
		align-items: center;
	}
	@media (min-width: 900px) {
		.cta {
			grid-template-columns: 1.3fr 1fr;
		}
		.cta-actions {
			justify-content: flex-end;
		}
	}
	.cta-copy p {
		margin-top: 16px;
		max-width: 460px;
		line-height: 1.7;
	}
	.cta-sub {
		font-size: 0.9rem;
	}
	.cta-sub a {
		color: #7fd9cc;
	}
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
</style>
