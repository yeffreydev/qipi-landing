---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import WaFab from "../components/WaFab.astro";
import "../styles/globals.css";

const SITE = "https://aquinace.com";
const APP = "https://app.aquinace.com";
const WA =
	"https://wa.me/51918796325?text=Hola%2C%20quiero%20conocer%20la%20plataforma%20de%20aqu%C3%AD%20nace%20%F0%9F%8C%B1";

const galleryImages = [
	"IMG_0221.webp",
	"IMG_20200318_095954.webp",
	"IMG_20201120_172316709.webp",
	"IMG_20211215_140457.webp",
	"IMG_2691.webp",
	"IMG_2692.webp",
	"IMG_2699.webp",
	"IMG_2737.webp",
	"IMG_2776.webp",
	"IMG_3695.webp",
];

const faqs = [
	{
		q: "¿Qué es aquí nace?",
		a: "aquí nace es una plataforma que conecta a las personas con oportunidades financieras reales y accesibles. No otorgamos créditos: ofrecemos la tecnología y la red para que gestiones y hagas crecer tus finanzas.",
	},
	{
		q: "¿aquí nace otorga créditos?",
		a: "No. aquí nace es la plataforma tecnológica que conecta a las personas con oportunidades financieras. Nosotros ofrecemos las herramientas y la red; las decisiones financieras las tomas tú.",
	},
	{
		q: "¿Para quién es aquí nace?",
		a: "Para emprendedores, familias y comunidades que quieren organizar y hacer crecer sus finanzas con una herramienta cercana y transparente.",
	},
];

const homeJsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "aquí nace",
		applicationCategory: "FinanceApplication",
		operatingSystem: "Web, Android, iOS",
		description:
			"Plataforma que conecta a las personas con oportunidades financieras reales y accesibles en Perú. Nosotros ofrecemos la tecnología; tú decides cómo crecer.",
		url: SITE,
		offers: { "@type": "Offer", price: "0", priceCurrency: "PEN" },
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((f) => ({
			"@type": "Question",
			name: f.q,
			acceptedAnswer: { "@type": "Answer", text: f.a },
		})),
	},
];
---

<Layout
	title="aquí nace — La plataforma que te conecta con más oportunidades financieras"
	description="aquí nace es la plataforma que conecta personas con oportunidades financieras reales y accesibles. No otorgamos créditos: ofrecemos la tecnología y la red para que crezcas."
	keywords="aquí nace, aquinace, plataforma financiera Perú, red financiera, herramienta de finanzas, oportunidades financieras, inclusión financiera, fintech Perú"
	canonicalPath="/"
	jsonLd={homeJsonLd}
>
	<Nav />

	<main>
		<!-- ================= HERO ================= -->
		<section class="hero" id="inicio">
			<div class="stripes" aria-hidden="true"></div>
			<div class="container hero-grid">
				<div class="hero-copy">
					<h1 class="h-display">
						Tu asociación de<br />
						créditos y ahorro<br />
						nace aquí.
					</h1>
					<p class="lead hero-lead">
						Digitaliza los aportes, préstamos y ahorros de tu comunidad.
						Transparente, simple y desde cualquier celular.
					</p>

					<div class="hero-cta">
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
							<svg class="wa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
							Escríbenos por WhatsApp
						</a>
						<a href={APP} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
							Ingresar a la app
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
					</div>
					<p class="hero-note">Respuesta inmediata · +51 918 796 325 · Sin compromisos</p>

					<ul class="hero-trust" aria-label="Tipos de comunidades que usan aquí nace">
						<li>UNICAs</li>
						<li>Bancas comunales</li>
						<li>Juntas</li>
						<li>Asociaciones</li>
					</ul>
				</div>

				<div class="hero-visual" aria-hidden="true">
					<div class="mock-card">
						<div class="mock-head">
							<div class="mock-avatar">a</div>
							<div class="mock-who">
								<strong>Comunidad Los Andes</strong>
								<span>18 socios · UNICA</span>
							</div>
						</div>
						<div class="mock-fund">
							<span>Fondo común</span>
							<strong>S/ 18,650.00</strong>
							<span>Ciclo 2026 · actualizado hoy</span>
						</div>
						<div class="mock-opt selected">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7-7 7 7" /></svg>
							<span>Registrar aporte</span>
							<i class="mock-radio on"></i>
						</div>
						<div class="mock-opt">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18M5 10V8l7-4 7 4v2M6 10v8M10 10v8M14 10v8M18 10v8M3 20h18" /></svg>
							<span>Solicitar préstamo</span>
							<i class="mock-radio"></i>
						</div>
						<div class="mock-pay">Confirmar</div>
					</div>

					<div class="mock-cc">
						<span class="mock-cc-label">Carné de socio</span>
						<strong class="mock-cc-num">0234 <em>****</em> <em>****</em></strong>
						<div class="mock-cc-foot">
							<img src="/aquinace-light.svg" alt="" width="90" height="26" />
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 8.5a6 6 0 0 1 0 7M9.5 6.5a9 9 0 0 1 0 11M13 4.5a12 12 0 0 1 0 15M16.5 2.5a15 15 0 0 1 0 19" /></svg>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= SERVICIOS (card blanca) ================= -->
		<section class="section-tight" id="servicios">
			<div class="container">
				<div class="card-raised features reveal">
					<div class="features-head">
						<div>
							<span class="eyebrow">Tu plataforma</span>
							<h2 class="h-section">Una experiencia que<br />crece con tu comunidad.</h2>
						</div>
						<p>
							Un sistema financiero comunitario que ordena los aportes, calcula los préstamos
							y muestra las cuentas claras a todos los socios.
						</p>
					</div>

					<div class="features-grid">
						<article class="feature">
							<svg class="icon-line" viewBox="0 0 40 40"><path d="M8 14h20l-4-4M32 26H12l4 4" /><rect x="6" y="8" width="28" height="24" rx="6" opacity="0" /></svg>
							<h3>Aportes ordenados</h3>
							<p>Registra cada aporte en segundos y olvida el cuaderno. Todo queda guardado, fechado y visible para la comunidad.</p>
						</article>
						<article class="feature">
							<svg class="icon-line" viewBox="0 0 40 40"><path d="M6 16h28M9 16v14M15 16v14M21 16v14M27 16v14M33 16v14M4 30h32M8 16l12-8 12 8" /></svg>
							<h3>Préstamos entre socios</h3>
							<p>Cuotas e intereses calculados de forma automática. El dinero se queda y circula dentro de tu comunidad.</p>
						</article>
						<article class="feature">
							<svg class="icon-line" viewBox="0 0 40 40"><path d="M20 4 8 9v9c0 8 5 14 12 17 7-3 12-9 12-17V9L20 4z" /><path d="m14 20 4 4 8-8" /></svg>
							<h3>Transparencia total</h3>
							<p>Cada socio ve la misma información desde su celular. Sin cuentas que no cuadran, sin dudas.</p>
						</article>
					</div>
				</div>
			</div>
		</section>

		<!-- ================= POR QUÉ (bento) ================= -->
		<section class="section" id="por-que">
			<div class="container">
				<div class="section-head reveal">
					<span class="eyebrow">Por qué nosotros</span>
					<h2 class="h-section">Por qué prefieren <span class="wordmark"><span class="wm-a">aquí</span><span class="wm-n">nace</span></span></h2>
				</div>

				<div class="bento">
					<article class="card-tint bento-stat reveal">
						<span class="bento-big">24/7</span>
						<h3 class="h-card">Las cuentas de tu comunidad, siempre a la mano</h3>
					</article>

					<article class="card-tint bento-transfer reveal">
						<h3 class="h-card">Registra aportes y préstamos al instante</h3>
						<div class="transfer">
							<span class="transfer-app">
								<img src="/aquinace-light.svg" alt="" width="52" height="16" />
							</span>
							<span class="transfer-arrows">
								<svg viewBox="0 0 96 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M88 7H8m0 0 4-4M8 7l4 4M8 17h80m0 0-4-4m4 4-4 4" /></svg>
							</span>
							<span class="transfer-bank">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 11a4 4 0 1 0-8 0 4 4 0 0 0 8 0zM4 21a8 8 0 0 1 16 0" /></svg>
							</span>
						</div>
					</article>

					<article class="card-tint bento-wide reveal">
						<div class="bento-wide-copy">
							<h3 class="h-card">Sin cuentas que no cuadran</h3>
							<p>Cada movimiento queda registrado y todos ven la misma información. El fondo de tu comunidad crece con orden.</p>
						</div>
						<div class="chart-card">
							<div class="chart-head">
								<div>
									<span>Fondo común</span>
									<strong>S/ 18,650.00</strong>
								</div>
								<span class="chart-range">6 meses ▾</span>
							</div>
							<svg class="chart" viewBox="0 0 520 170" preserveAspectRatio="none" aria-hidden="true">
								<defs>
									<linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0" stop-color="#0a8f80" stop-opacity="0.22" />
										<stop offset="1" stop-color="#0a8f80" stop-opacity="0" />
									</linearGradient>
								</defs>
								<path d="M0 150 L90 108 L170 90 L260 74 L350 62 L430 44 L520 12 L520 170 L0 170 Z" fill="url(#chart-fill)" />
								<path d="M0 150 L90 108 L170 90 L260 74 L350 62 L430 44 L520 12" fill="none" stroke="#0a8f80" stroke-width="2" stroke-linejoin="round" />
							</svg>
							<div class="chart-axis">
								<span>Ene</span><span>Feb</span><span>Mar</span><span>Abr</span><span>May</span><span>Jun</span>
							</div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- ================= PASOS (banda oscura) ================= -->
		<section class="band-dark steps" id="como-funciona">
			<div class="container">
				<div class="steps-head reveal">
					<span class="eyebrow">Cómo funciona</span>
					<h2 class="h-section">Empieza en 3 pasos y haz<br />crecer el fondo de tu comunidad.</h2>
				</div>
				<div class="steps-grid">
					<article class="step reveal">
						<span class="step-n">1</span>
						<h3>Crea tu cuenta</h3>
						<p>Entra a app.aquinace.com y regístrate, o escríbenos por WhatsApp y te ayudamos.</p>
					</article>
					<article class="step reveal">
						<span class="step-n">2</span>
						<h3>Explora</h3>
						<p>Accede a la plataforma y descubre las oportunidades que se ajustan a ti.</p>
					</article>
					<article class="step reveal">
						<span class="step-n">3</span>
						<h3>Crece con nosotros</h3>
						<p>Gestiona y haz crecer lo que realmente importa, a tu ritmo.</p>
					</article>
				</div>
			</div>
		</section>

		<!-- ================= MISIÓN + GALERÍA ================= -->
		<section class="section mission" id="mision">
			<div class="container">
				<div class="section-head reveal">
					<span class="eyebrow">Nuestra misión</span>
					<h2 class="h-section">Juntos, hacemos crecer<br />tus sueños.</h2>
					<p>
						Conectamos a las personas con oportunidades financieras reales y accesibles.
						Nosotros ofrecemos la tecnología y la red; tú decides cómo crecer.
					</p>
				</div>

				<div class="values reveal">
					<div class="value">
						<h3>Comunidad</h3>
						<p>Formamos una red de apoyo y confianza.</p>
					</div>
					<div class="value">
						<h3>Crecimiento</h3>
						<p>Soluciones financieras que impulsan tus metas.</p>
					</div>
					<div class="value">
						<h3>Confianza</h3>
						<p>Transparencia y seguridad en cada paso.</p>
					</div>
				</div>

				<div class="gallery reveal" id="galeria">
					{galleryImages.map((img) => (
						<figure class="g-item">
							<img src={`/gallery/${img}`} alt="Comunidad de aquí nace en actividad" loading="lazy" decoding="async" />
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- ================= PLANES / CAMINOS ================= -->
		<section class="section-tight plans">
			<div class="container">
				<p class="plans-label reveal">Elige tu camino:</p>
				<div class="plans-grid">
					<a href={APP} target="_blank" rel="noopener noreferrer" class="plan plan-light reveal">
						<h3>Comunidad</h3>
						<p>Crea tu asociación de créditos y ahorro y digitaliza aportes, préstamos e inversiones.</p>
						<div class="plan-foot">
							<span>Gratis para empezar</span>
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</div>
					</a>
					<a href="/token" class="plan plan-brand reveal">
						<div class="stripes on-brand" aria-hidden="true"></div>
						<h3>Token AN</h3>
						<p>El token creado para impulsar el proyecto y todo el ecosistema de aquí nace.</p>
						<div class="plan-foot">
							<span>Próximamente</span>
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</div>
					</a>
				</div>
			</div>
		</section>

		<!-- ================= FAQ ================= -->
		<section class="section-tight faq">
			<div class="container faq-inner">
				<div class="faq-head reveal">
					<span class="eyebrow">Preguntas frecuentes</span>
					<h2 class="h-section">Lo que más nos preguntan</h2>
				</div>
				<div class="faq-list reveal">
					{faqs.map((f) => (
						<details class="faq-item">
							<summary>
								<span>{f.q}</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
							</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<!-- ================= CTA FINAL ================= -->
		<section class="section-tight" id="contacto">
			<div class="container">
				<div class="cta band-dark reveal">
					<div class="cta-copy">
						<span class="eyebrow">Pruébala hoy</span>
						<h2 class="h-section">¿Listo para dar<br />el primer paso?</h2>
						<p>Escríbenos y empieza a usar la plataforma hoy. Aquí nace tu próxima oportunidad.</p>
					</div>
					<div class="cta-actions">
						<a href={APP} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Empezar ahora</a>
						<a href={WA} target="_blank" rel="noopener noreferrer" class="btn btn-ghost-dark btn-lg">
							Escríbenos
							<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<WaFab href={WA} />
	<Footer />
</Layout>

<style>
	/* ===== HERO ===== */
	.hero {
		position: relative;
		padding: calc(var(--nav-h) + 72px) 0 96px;
		overflow: hidden;
	}
	.hero .stripes {
		left: 50%;
	}
	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr;
		gap: 64px;
		align-items: center;
	}
	@media (min-width: 980px) {
		.hero-grid {
			grid-template-columns: 1.05fr 1fr;
			gap: 40px;
		}
	}
	.hero-copy h1 {
		margin-bottom: 26px;
	}
	.hero-lead {
		max-width: 480px;
		margin-bottom: 32px;
	}
	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.hero-cta .wa {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
	}
	.hero-note {
		margin-top: 14px;
		font-size: 0.85rem;
		color: var(--muted-2);
	}
	.hero-trust {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 12px 30px;
		margin-top: 44px;
	}
	.hero-trust li {
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
		color: var(--brand-deep);
		opacity: 0.85;
	}

	/* Mockup */
	.hero-visual {
		position: relative;
		min-height: 440px;
		max-width: 520px;
		margin: 0 auto;
		width: 100%;
	}
	.mock-card {
		position: relative;
		width: min(360px, 82%);
		background: var(--surface);
		border-radius: 22px;
		padding: 22px;
		box-shadow: var(--shadow-float);
		animation: float 7s ease-in-out infinite;
	}
	.mock-head {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 18px;
	}
	.mock-avatar {
		width: 42px;
		height: 42px;
		border-radius: 11px;
		background: var(--brand);
		color: #fff;
		font-family: var(--font-brand);
		font-weight: 700;
		font-size: 1.5rem;
		display: grid;
		place-items: center;
	}
	.mock-who {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}
	.mock-who strong {
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
	}
	.mock-who span {
		color: var(--muted-2);
		font-size: 0.78rem;
	}
	.mock-fund {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 16px;
		border: 1px solid var(--line);
		border-radius: 14px;
		margin-bottom: 12px;
	}
	.mock-fund span {
		font-size: 0.78rem;
		color: var(--muted);
	}
	.mock-fund strong {
		font-size: 1.7rem;
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--ink);
		line-height: 1.15;
	}
	.mock-opt {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 13px 14px;
		border: 1px solid var(--line);
		border-radius: 12px;
		font-size: 0.86rem;
		color: var(--ink);
		margin-bottom: 10px;
	}
	.mock-opt svg {
		width: 18px;
		height: 18px;
		color: var(--brand-deep);
	}
	.mock-opt span {
		flex: 1;
	}
	.mock-opt.selected {
		border-color: var(--brand);
	}
	.mock-radio {
